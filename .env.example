# Copy this file to ".env" (same folder as server.js) and fill in what you use.
# Real environment variables override this file. Restart the server after changes.
# Leave a section empty to keep that channel switched off.

# Link put in notifications (your site address)
APP_URL=https://tasks.example.com

# --- Slack -------------------------------------------------------------
# Bot token of a Slack app with scopes: chat:write, users:read.email, im:write
# Members are found by their login email, so it must match their Slack email.
SLACK_BOT_TOKEN=
# Where admin status updates go (use ONE of these; if both are empty the
# bot sends a DM to each admin instead):
SLACK_ADMIN_CHANNEL=
SLACK_WEBHOOK_URL=

# --- Email (SMTP) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CloudTech Bookkeeping <notifications@example.com>"
# Set to 1 to also email admins when a member changes a task status
NOTIFY_ADMIN_EMAIL=0
# Set to 1 only if your mail server uses a self-signed certificate
SMTP_ALLOW_SELF_SIGNED=0

# --- Server / security ---------------------------------------------------
# Run the site behind HTTPS (Nginx or Caddy) with NODE_ENV=production. In that
# mode secure cookies, HSTS and the reverse-proxy address are switched on.
NODE_ENV=production
# A long random string (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Without it everyone is logged out whenever the server restarts.
SESSION_SECRET=
# Only used the very first time, when there is no admin login yet. If ADMIN_PASSWORD is
# empty a random password is created and printed once in the server log.
ADMIN_EMAIL=cloudtechacademybd@gmail.com
ADMIN_PASSWORD=
